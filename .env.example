# Copy to .env and fill in. .env is not committed to git.

# Zero Trust > Settings > Team name and domain, e.g. yourteam.cloudflareaccess.com
CF_TEAM_DOMAIN=yourteam.cloudflareaccess.com

# Zero Trust > Access > Applications > vocab > Overview > "Application Audience (AUD) Tag"
CF_ACCESS_AUD=paste-the-aud-tag-here

# Optional second check on top of the Access policy (comma-separated, any case)
ALLOWED_EMAILS=

# Correct answers in a row before a word counts as learned
LEARNED_STREAK=2
